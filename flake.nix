{
  description = "RustFetch — A blazing-fast, memory-safe system fetch tool written in Rust";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
  };

  outputs = { self, nixpkgs }:
    let
      supportedSystems = [ "x86_64-linux" "aarch64-linux" ];
      forAllSystems = nixpkgs.lib.genAttrs supportedSystems;
    in
    {
      packages = forAllSystems (system:
        let
          pkgs = nixpkgs.legacyPackages.${system};
        in
        {
          default = pkgs.rustPlatform.buildRustPackage {
            pname = "rustfetch";
            version = "0.1.5";
            src = ./.;
            cargoLock = {
              lockFile = ./Cargo.lock;
            };
            postInstall = ''
              # Man page (and the rfetch alias).
              install -Dm644 docs/rustfetch.1 "$out/share/man/man1/rustfetch.1"
              ln -sf rustfetch.1 "$out/share/man/man1/rfetch.1"

              # Shell completions generated by the freshly built binary.
              install -d "$out/share/bash-completion/completions"
              "$out/bin/rustfetch" --completions bash > "$out/share/bash-completion/completions/rustfetch"
              ln -sf rustfetch "$out/share/bash-completion/completions/rfetch"

              install -d "$out/share/zsh/site-functions"
              "$out/bin/rustfetch" --completions zsh > "$out/share/zsh/site-functions/_rustfetch"
              ln -sf _rustfetch "$out/share/zsh/site-functions/_rfetch"

              install -d "$out/share/fish/vendor_completions.d"
              "$out/bin/rustfetch" --completions fish > "$out/share/fish/vendor_completions.d/rustfetch.fish"
              ln -sf rustfetch.fish "$out/share/fish/vendor_completions.d/rfetch.fish"
            '';
            meta = with pkgs.lib; {
              description = "Blazing-fast, memory-safe system fetch tool written in Rust";
              homepage = "https://github.com/MehmetCanWT/rustfetch";
              license = licenses.mit;
              platforms = platforms.linux;
              mainProgram = "rustfetch";
            };
          };
        });
    };
}
